# ============================================================
# KARDEX VIRTUAL - Variables de entorno
# ============================================================

# Base de datos PostgreSQL en Aiven (SSL obligatorio)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL="postgresql://avnadmin:TU_PASSWORD@tu-host.aivencloud.com:12345/defaultdb?sslmode=require"

# Certificado CA de Aiven (contenido completo del .pem, saltos de línea como \n)
# Ejemplo: "-----BEGIN CERTIFICATE-----\nMII...\n-----END CERTIFICATE-----"
AIVEN_CA_CERT=""

# Secreto para firmar JWT (usa una cadena larga y aleatoria en producción)
JWT_SECRET="cambia-este-secreto-por-uno-seguro-y-largo-en-produccion"

# Puerto para desarrollo local
PORT=3000

# Entorno
NODE_ENV=development
